set -e

mkdir -p src/types src/lib src/components src/app

# 1. src/types/bot.ts
cat << 'EOF' > src/types/bot.ts
export type PairSymbol = 'XAUUSD' | 'EURUSD' | 'AUDUSD' | 'GBPUSD';
export type TradeDirection = 'CALL' | 'PUT';
export type TradeStatus = 'ACTIVE' | 'WIN' | 'LOSS' | 'TIE';
export type SocketConnectionStatus = 'CONNECTED' | 'RECONNECTING' | 'DISCONNECTED' | 'SIMULATOR';

export interface Candle {
  time: number; // Strictly 60s-aligned Unix timestamp in seconds
  open: number;
  high: number;
  low: number;
  close: number;
}

export interface ConfluenceChecklist {
  trendAligned: boolean;
  liquiditySweep: boolean;
  fvgImbalance: boolean;
  oteFibZone: boolean;
  rsiExhaustion: boolean;
  atrRegimeClean: boolean;
}

export interface SignalDiagnostics {
  pair: PairSymbol;
  timestamp: number;
  close: number;
  ema50: number;
  bbUpper: number;
  bbLower: number;
  rsi7: number;
  atr14: number;
  oteHigh: number;
  oteLow: number;
  candleRange: number;
  lowerWickRatio: number;
  upperWickRatio: number;
  confluenceScore: number; // 0 to 100
  checklist: ConfluenceChecklist;
  atrSpikeBlocked: boolean;
  signal: TradeDirection | null;
  reason: string;
}

export interface BotConfig {
  ssid: string;
  isDemo: boolean;
  useSimulator: boolean;
  activePairs: PairSymbol[];
  selectedPair: PairSymbol;
  expirySeconds: 60 | 120 | 180;
  riskPercent: number;
  fixedStakeFallback: number;
  minPayoutPercent: number;
  cooldownCandles: number;
  dailyStopLossPercent: number;
  maxConsecutiveLosses: number;
  dailyTakeProfitPercent: number;
}

export interface TradeRecord {
  id: string;
  pair: PairSymbol;
  direction: TradeDirection;
  entryPrice: number;
  exitPrice?: number;
  stake: number;
  payoutPercent: number;
  entryTime: number;
  expiryTime: number;
  status: TradeStatus;
  profit: number;
}

export interface RiskTelemetry {
  startingDailyBalance: number;
  currentBalance: number;
  netPnL: number;
  pnlPercent: number;
  consecutiveLosses: number;
  isHalted: boolean;
  haltReason: string | null;
}
EOF

# 2. src/lib/strategy.ts
cat << 'EOF' > src/lib/strategy.ts
import { Candle, ConfluenceChecklist, PairSymbol, SignalDiagnostics } from '@/types/bot';

export class StrategyEngine {
  private static calcEMA(values: number[], period: number): number {
    if (values.length < period) return values[values.length - 1] ?? 0;
    const k = 2 / (period + 1);
    let ema = values.slice(0, period).reduce((a, b) => a + b, 0) / period;
    for (let i = period; i < values.length; i++) {
      ema = values[i] * k + ema * (1 - k);
    }
    return ema;
  }

  private static calcBollingerBands(closes: number[], period = 20, stdDevMult = 2.0) {
    const slice = closes.slice(-period);
    const mean = slice.reduce((a, b) => a + b, 0) / slice.length;
    const variance = slice.reduce((sum, val) => sum + Math.pow(val - mean, 2), 0) / slice.length;
    const stdDev = Math.sqrt(variance);
    return {
      middle: mean,
      upper: mean + stdDevMult * stdDev,
      lower: mean - stdDevMult * stdDev,
    };
  }

  private static calcRSI(closes: number[], period = 7): number {
    if (closes.length <= period) return 50;
    let gains = 0;
    let losses = 0;

    for (let i = 1; i <= period; i++) {
      const diff = closes[i] - closes[i - 1];
      if (diff >= 0) gains += diff;
      else losses -= diff;
    }

    let avgGain = gains / period;
    let avgLoss = losses / period;

    for (let i = period + 1; i < closes.length; i++) {
      const diff = closes[i] - closes[i - 1];
      const gain = diff > 0 ? diff : 0;
      const loss = diff < 0 ? -diff : 0;
      avgGain = (avgGain * (period - 1) + gain) / period;
      avgLoss = (avgLoss * (period - 1) + loss) / period;
    }

    if (avgLoss === 0) return 100;
    const rs = avgGain / avgLoss;
    return 100 - 100 / (1 + rs);
  }

  private static calcATR(candles: Candle[], period = 14): number {
    if (candles.length <= period) return 0.0005;
    const trs: number[] = [];
    for (let i = 1; i < candles.length; i++) {
      const current = candles[i];
      const prevClose = candles[i - 1].close;
      const tr = Math.max(
        current.high - current.low,
        Math.abs(current.high - prevClose),
        Math.abs(current.low - prevClose)
      );
      trs.push(tr);
    }
    const recentTRs = trs.slice(-period);
    return recentTRs.reduce((a, b) => a + b, 0) / recentTRs.length;
  }

  public static evaluate(pair: PairSymbol, candles: Candle[]): SignalDiagnostics {
    const emptyChecklist: ConfluenceChecklist = {
      trendAligned: false,
      liquiditySweep: false,
      fvgImbalance: false,
      oteFibZone: false,
      rsiExhaustion: false,
      atrRegimeClean: true,
    };

    if (candles.length < 55) {
      const last = candles[candles.length - 1];
      return {
        pair,
        timestamp: last?.time ?? Math.floor(Date.now() / 1000),
        close: last?.close ?? 0,
        ema50: 0,
        bbUpper: 0,
        bbLower: 0,
        rsi7: 50,
        atr14: 0,
        oteHigh: 0,
        oteLow: 0,
        candleRange: 0,
        lowerWickRatio: 0,
        upperWickRatio: 0,
        confluenceScore: 0,
        checklist: emptyChecklist,
        atrSpikeBlocked: false,
        signal: null,
        reason: `Calibrating institutional microstructure (${candles.length}/55)`,
      };
    }

    const closes = candles.map((c) => c.close);
    const current = candles[candles.length - 1];
    const prev1 = candles[candles.length - 2];
    const prev3 = candles[candles.length - 4];
    const prior10 = candles.slice(-11, -1);
    const prior20 = candles.slice(-21, -1);

    const ema50 = this.calcEMA(closes, 50);
    const bb = this.calcBollingerBands(closes, 20, 2.0);
    const rsi7 = this.calcRSI(closes, 7);
    const atr14 = this.calcATR(candles, 14);

    const swingLow10 = Math.min(...prior10.map((c) => c.low));
    const swingHigh10 = Math.max(...prior10.map((c) => c.high));

    // 20-bar Dealing Range for OTE Fibonacci (0.618 - 0.786)
    const rangeLow20 = Math.min(...prior20.map((c) => c.low));
    const rangeHigh20 = Math.max(...prior20.map((c) => c.high));
    const dealingRange = Math.max(rangeHigh20 - rangeLow20, 1e-6);

    const bullOteTop = rangeHigh20 - dealingRange * 0.618;
    const bullOteBottom = rangeHigh20 - dealingRange * 0.85;
    const bearOteBottom = rangeLow20 + dealingRange * 0.618;
    const bearOteTop = rangeLow20 + dealingRange * 0.85;

    const candleRange = Math.max(current.high - current.low, 1e-6);
    const lowerWick = Math.min(current.open, current.close) - current.low;
    const upperWick = current.high - Math.max(current.open, current.close);
    const lowerWickRatio = lowerWick / candleRange;
    const upperWickRatio = upperWick / candleRange;

    // 1. ATR Volatility Regime Filter
    const atrSpikeBlocked = candleRange > atr14 * 2.6 || candleRange < atr14 * 0.35;
    const atrRegimeClean = !atrSpikeBlocked;

    // 2. Fair Value Gap (FVG) / Displacement Imbalance
    const bullishFvg = prev3 ? current.low > prev3.high || prev1.low < bb.lower : false;
    const bearishFvg = prev3 ? current.high < prev3.low || prev1.high > bb.upper : false;

    // 3. OTE Fibonacci Pocket Check
    const inBullOte = current.low <= bullOteTop && current.close >= bullOteBottom;
    const inBearOte = current.high >= bearOteBottom && current.close <= bearOteTop;

    // 4. Liquidity Sweep & Wick Rejection
    const bullSweep =
      (current.low < bb.lower || current.low <= swingLow10) &&
      current.close > bb.lower &&
      lowerWickRatio >= 0.38;

    const bearSweep =
      (current.high > bb.upper || current.high >= swingHigh10) &&
      current.close < bb.upper &&
      upperWickRatio >= 0.38;

    // 5. Trend & RSI Exhaustion
    const bullTrend = current.close >= ema50 * 0.998;
    const bearTrend = current.close <= ema50 * 1.002;
    const bullRsi = rsi7 < 30;
    const bearRsi = rsi7 > 70;

    // Score Calculation (Bullish vs Bearish)
    const bullScore =
      (bullSweep ? 35 : 0) +
      (bullRsi ? 25 : 0) +
      (bullTrend ? 15 : 0) +
      (inBullOte ? 15 : 0) +
      (bullishFvg ? 10 : 0);

    const bearScore =
      (bearSweep ? 35 : 0) +
      (bearRsi ? 25 : 0) +
      (bearTrend ? 15 : 0) +
      (inBearOte ? 15 : 0) +
      (bearishFvg ? 10 : 0);

    const isBullDominant = bullScore >= bearScore;
    const rawScore = isBullDominant ? bullScore : bearScore;
    const confluenceScore = atrRegimeClean ? rawScore : Math.min(rawScore, 40);

    const checklist: ConfluenceChecklist = {
      trendAligned: isBullDominant ? bullTrend : bearTrend,
      liquiditySweep: isBullDominant ? bullSweep : bearSweep,
      fvgImbalance: isBullDominant ? bullishFvg : bearishFvg,
      oteFibZone: isBullDominant ? inBullOte : inBearOte,
      rsiExhaustion: isBullDominant ? bullRsi : bearRsi,
      atrRegimeClean,
    };

    if (atrSpikeBlocked) {
      return {
        pair,
        timestamp: current.time,
        close: current.close,
        ema50,
        bbUpper: bb.upper,
        bbLower: bb.lower,
        rsi7,
        atr14,
        oteHigh: bullOteTop,
        oteLow: bullOteBottom,
        candleRange,
        lowerWickRatio,
        upperWickRatio,
        confluenceScore,
        checklist,
        atrSpikeBlocked: true,
        signal: null,
        reason: 'ATR Guard: Volatility outside institutional bounds (0.35x - 2.6x)',
      };
    }

    if (bullSweep && bullRsi && bullTrend) {
      return {
        pair,
        timestamp: current.time,
        close: current.close,
        ema50,
        bbUpper: bb.upper,
        bbLower: bb.lower,
        rsi7,
        atr14,
        oteHigh: bullOteTop,
        oteLow: bullOteBottom,
        candleRange,
        lowerWickRatio,
        upperWickRatio,
        confluenceScore: Math.max(82, confluenceScore),
        checklist,
        atrSpikeBlocked: false,
        signal: 'CALL',
        reason: `CALL Executed: Sell-Side Liquidity Sweep + ${(lowerWickRatio * 100).toFixed(0)}% Wick + RSI ${rsi7.toFixed(1)}`,
      };
    }

    if (bearSweep && bearRsi && bearTrend) {
      return {
        pair,
        timestamp: current.time,
        close: current.close,
        ema50,
        bbUpper: bb.upper,
        bbLower: bb.lower,
        rsi7,
        atr14,
        oteHigh: bearOteTop,
        oteLow: bearOteBottom,
        candleRange,
        lowerWickRatio,
        upperWickRatio,
        confluenceScore: Math.max(82, confluenceScore),
        checklist,
        atrSpikeBlocked: false,
        signal: 'PUT',
        reason: `PUT Executed: Buy-Side Liquidity Sweep + ${(upperWickRatio * 100).toFixed(0)}% Wick + RSI ${rsi7.toFixed(1)}`,
      };
    }

    return {
      pair,
      timestamp: current.time,
      close: current.close,
      ema50,
      bbUpper: bb.upper,
      bbLower: bb.lower,
      rsi7,
      atr14,
      oteHigh: bullOteTop,
      oteLow: bullOteBottom,
      candleRange,
      lowerWickRatio,
      upperWickRatio,
      confluenceScore,
      checklist,
      atrSpikeBlocked: false,
      signal: null,
      reason: `Confluence ${confluenceScore}% — Scanning for stop-hunt & BB rejection`,
    };
  }
}
EOF

# 3. src/lib/pocketSocket.ts
cat << 'EOF' > src/lib/pocketSocket.ts
import { PairSymbol, SocketConnectionStatus, TradeDirection } from '@/types/bot';

type TickHandler = (pair: PairSymbol, price: number, timestamp: number, payout: number) => void;
type StatusHandler = (status: SocketConnectionStatus) => void;

export class PocketSocketClient {
  private ws: WebSocket | null = null;
  private reconnectAttempts = 0;
  private maxReconnectDelay = 30000;
  private simTimer: ReturnType<typeof setInterval> | null = null;
  private onTick: TickHandler;
  private onStatus: StatusHandler;
  private currentSsid = '';
  private isSimulating = false;

  private simPrices: Record<PairSymbol, number> = {
    XAUUSD: 2648.50,
    EURUSD: 1.08520,
    AUDUSD: 0.65840,
    GBPUSD: 1.29410,
  };

  private endpoint = 'wss://demo-api-eu.po.market/socket.io/?EIO=4&transport=websocket';

  constructor(onTick: TickHandler, onStatus: StatusHandler) {
    this.onTick = onTick;
    this.onStatus = onStatus;
  }

  public connect(ssid: string, useSimulator: boolean) {
    this.currentSsid = ssid;
    this.isSimulating = useSimulator;
    this.disconnect();

    if (useSimulator || !ssid.trim()) {
      this.startSimulator();
      return;
    }

    try {
      this.ws = new WebSocket(this.endpoint);

      this.ws.onopen = () => {
        this.reconnectAttempts = 0;
        this.onStatus('CONNECTED');
        this.ws?.send('40');

        setTimeout(() => {
          const authPayload = ssid.startsWith('42')
            ? ssid
            : `42["auth",{"session":"${ssid}","isDemo":1}]`;
          this.ws?.send(authPayload);
          this.subscribePairs(['XAUUSD', 'EURUSD', 'AUDUSD', 'GBPUSD']);
        }, 500);
      };

      this.ws.onmessage = (event) => {
        const msg = String(event.data);
        if (msg === '2') {
          this.ws?.send('3');
          return;
        }
        if (msg.startsWith('42')) {
          this.handleSocketEvent(msg.slice(2));
        }
      };

      this.ws.onclose = () => {
        this.onStatus('RECONNECTING');
        this.retryConnection();
      };

      this.ws.onerror = () => {
        this.ws?.close();
      };
    } catch {
      this.retryConnection();
    }
  }

  private subscribePairs(pairs: PairSymbol[]) {
    pairs.forEach((pair) => {
      this.ws?.send(`42["changeSymbol",{"asset":"${pair}","period":60}]`);
    });
  }

  private handleSocketEvent(rawJson: string) {
    try {
      const parsed = JSON.parse(rawJson);
      if (!Array.isArray(parsed)) return;
      const [event, payload] = parsed;

      if (event === 'updateStream' && Array.isArray(payload)) {
        for (const item of payload) {
          const [asset, time, price] = item;
          if (['XAUUSD', 'EURUSD', 'AUDUSD', 'GBPUSD'].includes(asset)) {
            this.onTick(asset as PairSymbol, Number(price), Number(time), 88);
          }
        }
      }
    } catch {}
  }

  public executeOrder(
    pair: PairSymbol,
    action: TradeDirection,
    amount: number,
    expirySeconds: number
  ) {
    if (this.isSimulating || !this.ws || this.ws.readyState !== WebSocket.OPEN) {
      return;
    }
    const dir = action === 'CALL' ? 'call' : 'put';
    const payload = `42["openOrder",{"asset":"${pair}","amount":${amount},"action":"${dir}","isDemo":1,"time":${expirySeconds}}]`;
    this.ws.send(payload);
  }

  private retryConnection() {
    this.reconnectAttempts += 1;
    const delay = Math.min(1000 * Math.pow(2, this.reconnectAttempts), this.maxReconnectDelay);
    setTimeout(() => {
      this.connect(this.currentSsid, this.isSimulating);
    }, delay);
  }

  private startSimulator() {
    this.onStatus('SIMULATOR');

    this.simTimer = setInterval(() => {
      const now = Math.floor(Date.now() / 1000);
      (['XAUUSD', 'EURUSD', 'AUDUSD', 'GBPUSD'] as PairSymbol[]).forEach((pair) => {
        const step = pair === 'XAUUSD' ? 0.35 : 0.00018;
        const meanRevert = (Math.random() - 0.498) * step;
        const decimals = pair === 'XAUUSD' ? 2 : 5;
        this.simPrices[pair] = Number((this.simPrices[pair] + meanRevert).toFixed(decimals));
        const payout = pair === 'XAUUSD' ? 92 : 88;
        this.onTick(pair, this.simPrices[pair], now, payout);
      });
    }, 800);
  }

  public disconnect() {
    if (this.simTimer) {
      clearInterval(this.simTimer);
      this.simTimer = null;
    }
    if (this.ws) {
      this.ws.onclose = null;
      this.ws.onerror = null;
      this.ws.close();
      this.ws = null;
    }
    this.onStatus('DISCONNECTED');
  }
}
EOF

# 4. src/components/ChartCanvas.tsx
cat << 'EOF' > src/components/ChartCanvas.tsx
'use client';

import React, { useEffect, useRef } from 'react';
import {
  createChart,
  IChartApi,
  ISeriesApi,
  UTCTimestamp,
  SeriesMarker,
  IPriceLine,
} from 'lightweight-charts';
import { Candle, PairSymbol, SignalDiagnostics, TradeRecord } from '@/types/bot';

interface ChartCanvasProps {
  pair: PairSymbol;
  candles: Candle[];
  diagnostics: SignalDiagnostics | null;
  activeTrade: TradeRecord | null;
}

export const ChartCanvas: React.FC<ChartCanvasProps> = ({
  pair,
  candles,
  diagnostics,
  activeTrade,
}) => {
  const containerRef = useRef<HTMLDivElement>(null);
  const chartRef = useRef<IChartApi | null>(null);
  const candleSeriesRef = useRef<ISeriesApi<'Candlestick'> | null>(null);
  const emaSeriesRef = useRef<ISeriesApi<'Line'> | null>(null);
  const bbUpperSeriesRef = useRef<ISeriesApi<'Line'> | null>(null);
  const bbLowerSeriesRef = useRef<ISeriesApi<'Line'> | null>(null);
  const strikeLineRef = useRef<IPriceLine | null>(null);

  useEffect(() => {
    const el = containerRef.current;
    if (!el) return;

    const width = el.clientWidth || 340;
    const height = el.clientHeight || 260;

    const chart = createChart(el, {
      width,
      height,
      layout: {
        background: { color: '#07090E' },
        textColor: '#64748B',
        fontSize: 10,
        fontFamily: 'JetBrains Mono, monospace',
      },
      grid: {
        vertLines: { color: 'rgba(255, 255, 255, 0.03)' },
        horzLines: { color: 'rgba(255, 255, 255, 0.03)' },
      },
      timeScale: {
        timeVisible: true,
        secondsVisible: false,
        borderColor: 'rgba(255, 255, 255, 0.08)',
        rightOffset: 3,
        barSpacing: 7,
      },
      rightPriceScale: {
        borderColor: 'rgba(255, 255, 255, 0.08)',
        scaleMargins: { top: 0.12, bottom: 0.15 },
      },
      crosshair: {
        vertLine: { color: 'rgba(56, 189, 248, 0.35)', width: 1 },
        horzLine: { color: 'rgba(56, 189, 248, 0.35)', width: 1 },
      },
    });

    candleSeriesRef.current = chart.addCandlestickSeries({
      upColor: '#10B981',
      downColor: '#F43F5E',
      borderVisible: false,
      wickUpColor: '#10B981',
      wickDownColor: '#F43F5E',
      priceFormat: {
        type: 'price',
        precision: pair === 'XAUUSD' ? 2 : 5,
        minMove: pair === 'XAUUSD' ? 0.01 : 0.00001,
      },
    });

    emaSeriesRef.current = chart.addLineSeries({
      color: '#38BDF8',
      lineWidth: 2,
      priceLineVisible: false,
    });

    bbUpperSeriesRef.current = chart.addLineSeries({
      color: 'rgba(148, 163, 184, 0.32)',
      lineWidth: 1,
      lineStyle: 2,
      priceLineVisible: false,
    });

    bbLowerSeriesRef.current = chart.addLineSeries({
      color: 'rgba(148, 163, 184, 0.32)',
      lineWidth: 1,
      lineStyle: 2,
      priceLineVisible: false,
    });

    chartRef.current = chart;

    const ro = new ResizeObserver((entries) => {
      for (const entry of entries) {
        const { width: w, height: h } = entry.contentRect;
        if (w > 0 && h > 0 && chartRef.current) {
          chartRef.current.applyOptions({ width: w, height: h });
        }
      }
    });

    ro.observe(el);

    return () => {
      ro.disconnect();
      chart.remove();
    };
  }, [pair]);

  useEffect(() => {
    if (!candleSeriesRef.current || candles.length === 0) return;

    // Deduplicate & strictly sort by ascending timestamp so lightweight-charts never crashes
    const mapByTime = new Map<number, Candle>();
    for (const c of candles) {
      mapByTime.set(Math.floor(c.time / 60) * 60, {
        ...c,
        time: Math.floor(c.time / 60) * 60,
      });
    }
    const sorted = Array.from(mapByTime.values()).sort((a, b) => a.time - b.time);

    const formatted = sorted.map((c) => ({
      time: c.time as UTCTimestamp,
      open: c.open,
      high: c.high,
      low: c.low,
      close: c.close,
    }));

    candleSeriesRef.current.setData(formatted);

    if (
      sorted.length >= 50 &&
      emaSeriesRef.current &&
      bbUpperSeriesRef.current &&
      bbLowerSeriesRef.current
    ) {
      const k = 2 / 51;
      let ema = 

